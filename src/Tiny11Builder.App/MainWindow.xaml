<Window
    x:Class="Tiny11Builder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Tiny11 Builder">
    <Window.SystemBackdrop><MicaBackdrop Kind="BaseAlt"/></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleArea" Padding="24,0,140,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F8;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Grid.Column="1" Text="Tiny11 Builder" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Padding="16,24,16,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Spacing="8">
                    <TextBlock Text="ETAPAS DE CRIAÇÃO" FontSize="10" CharacterSpacing="160"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="14,0,0,18"/>
                    <ListView x:Name="StepRail" SelectionChanged="OnRailChanged">
                        <ListViewItem Tag="0"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="1" FontFamily="Consolas"/><TextBlock Text="Boas-vindas"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="1"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="2" FontFamily="Consolas"/><TextBlock Text="Imagem do Windows"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="2"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="3" FontFamily="Consolas"/><TextBlock Text="Remover componentes"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="3"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="4" FontFamily="Consolas"/><TextBlock Text="Configurações de criação"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="4"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="5" FontFamily="Consolas"/><TextBlock Text="Revisar"/></StackPanel></ListViewItem>
                        <ListViewItem Tag="5"><StackPanel Orientation="Horizontal" Spacing="14"><TextBlock Text="6" FontFamily="Consolas"/><TextBlock Text="Criar imagem"/></StackPanel></ListViewItem>
                    </ListView>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="12">
                    <Border Style="{StaticResource Card}" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="IMAGEM SELECIONADA" FontSize="10" CharacterSpacing="120"/>
                            <TextBlock x:Name="ImageBadge" Text="Nenhuma imagem selecionada" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Os arquivos de origem não são modificados." FontSize="12" Style="{StaticResource Secondary}"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ResumeButton" Content="Retomar criação" Click="OnResume" HorizontalAlignment="Stretch"
                            AutomationProperties.HelpText="Continua uma criação interrompida a partir do progresso salvo."/>
                    <Button x:Name="RecoverButton" Content="Recuperar área de trabalho" Click="OnRecover" HorizontalAlignment="Stretch"/>
                    <ComboBox x:Name="ThemeChoice" Header="Aparência" SelectionChanged="OnThemeChanged" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Sistema"/><ComboBoxItem Content="Claro"/><ComboBoxItem Content="Escuro"/>
                    </ComboBox>
                    <HyperlinkButton Content="Projeto original ↗" NavigateUri="https://github.com/ntdevlabs/tiny11builder" Padding="0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="1" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="16,0,0,0"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0">
                <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- The fixed shell row: Back on the left, Cancel on the right, above the scrolling page and its watermark. -->
                <Grid x:Name="ShellRow" Padding="28,0,28,0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button x:Name="BackButton" Click="OnBack" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="Transparent" BorderThickness="0" Padding="12,8" AutomationProperties.Name="Voltar">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE72B;" FontSize="16" Opacity="{ThemeResource SubtleIconOpacity}"/>
                                <TextBlock Text="Voltar" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Button.Content>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Left" Modifiers="Menu"/>
                        </Button.KeyboardAccelerators>
                    </Button>
                    <TextBlock x:Name="BusyText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,12,0,0" IsHitTestVisible="False"
                               Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                               FontSize="12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource CriticalButtonStyle}" Visibility="Collapsed" Click="OnCancel"
                            VerticalAlignment="Top" Margin="0,12,0,0" Padding="14,8" AutomationProperties.Name="Cancelar com segurança">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" FontSize="14"/>
                            <TextBlock Text="Cancelar com segurança"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="32,12,32,0">
                    <InfoBar.ActionButton>
                        <Button x:Name="NoticeButton" Click="OnNoticeAction" Visibility="Collapsed"/>
                    </InfoBar.ActionButton>
                </InfoBar>
                <ScrollViewer x:Name="ContentScroller" Grid.Row="2" Padding="40,24,40,20" HorizontalScrollBarVisibility="Disabled"
                              SizeChanged="OnContentSizeChanged" ViewChanged="OnContentViewChanged">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid x:Name="WelcomePanel" RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="WelcomeTitle" Text="Boas-vindas" FontSize="56" FontWeight="Light" Opacity="{ThemeResource WelcomeTitleOpacity}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"
                                           AutomationProperties.HeadingLevel="Level1"/>
                                <TextBlock Text="Crie uma ISO personalizada do Windows 11. Selecione uma imagem, escolha o que remover e crie a ISO."
                                           FontSize="16" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                            <Grid Grid.Row="1" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="Modos de criação" FontSize="18" FontWeight="SemiBold"/>
                                <Grid x:Name="ModeCards" Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="RegularModeCard" Style="{StaticResource ModeCard}" Tag="Tiny11" Click="OnModeCardClick"
                                            AutomationProperties.Name="Tiny11" AutomationProperties.HelpText="Selecione Tiny11 e escolha uma ISO do Windows.">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE7F4;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Tiny11" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Usa as remoções originais do Tiny11. Mantém o Windows Update e a recuperação."
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Suporte a atualizações mantido" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CoreModeCard" Grid.Column="1" Style="{StaticResource ModeCard}" Tag="Tiny11Core" Click="OnModeCardClick"
                                            AutomationProperties.Name="Tiny11 Core" AutomationProperties.HelpText="Selecione Tiny11 Core e escolha uma ISO do Windows.">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE8B7;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Tiny11 Core" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Remove o suporte a atualizações e recuperação e desativa o Defender."
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Apenas para máquinas virtuais de teste" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="CustomModeCard" Grid.Column="2" Style="{StaticResource ModeCard}" Tag="Custom" Click="OnModeCardClick"
                                            AutomationProperties.Name="Personalizado" AutomationProperties.HelpText="Selecione Personalizado e escolha uma ISO do Windows.">
                                        <Grid RowSpacing="12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <FontIcon Glyph="&#xE713;" FontSize="64" HorizontalAlignment="Left"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <StackPanel Grid.Row="1" Spacing="10">
                                                <TextBlock Text="Personalizado" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="Selecione os aplicativos, componentes e serviços que deseja remover."
                                                           Style="{StaticResource Secondary}" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Inclui itens protegidos" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>
                                    </Button>
                                </Grid>
                            </Grid>
                            <Grid Grid.Row="2" Padding="0,16,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Windows 11 22H2 ou mais recente · x64 e ARM64 · Insider / Canary" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="Teste imagens Core e personalizadas em uma máquina virtual antes de usar."
                                               Style="{StaticResource Secondary}" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="SourcePanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="Imagem do Windows" Style="{StaticResource PageHeading}"/>
                            <TextBlock x:Name="SourceMode" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="13"/>
                            <TextBlock Text="Baixe o Windows 11 mais recente da Microsoft ou selecione uma ISO ou pasta de instalação extraída. Analise a imagem para selecionar uma edição."
                                       Style="{StaticResource Secondary}"/>
                            <Grid x:Name="SourceCards" ColumnSpacing="16" RowSpacing="20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border x:Name="LocalMediaCard" Grid.Row="1" Style="{StaticResource Card}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Mídia de instalação local" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    <TextBox x:Name="SourcePathBox" Header="ISO do Windows ou pasta da mídia de instalação" TextChanged="OnSourceChanged" PlaceholderText="Escolha uma imagem do Windows 11"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="Escolher ISO" Click="OnChooseIso"/>
                                        <Button Content="Escolher pasta" Click="OnChooseSourceFolder"/>
                                        <Button Content="Analisar imagem" Click="OnInspect" Style="{StaticResource AccentButtonStyle}"/>
                                    </StackPanel>
                                    <ComboBox x:Name="EditionChoice" Header="Edição para criar" DisplayMemberPath="Summary"
                                              SelectionChanged="OnEditionChanged" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="DownloadCard" RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Button Style="{StaticResource ModeCard}" MinHeight="150" Click="OnDownloadLatest" AutomationProperties.Name="Baixar o Windows 11 mais recente">
                                    <Grid ColumnSpacing="24" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE896;" FontSize="52" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="Baixar o Windows 11 mais recente" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="LatestDownloadDescription" Text="ISO oficial da Microsoft. Arquitetura e idioma selecionados automaticamente." Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                        <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource CardArrowOpacity}"/>
                                    </Grid>
                                </Button>
                                <ProgressBar Grid.Row="1" x:Name="DownloadBar" Minimum="0" Maximum="100" Value="0" AutomationProperties.Name="Progresso do download"/>
                                <TextBlock Grid.Row="2" x:Name="DownloadStatus" Text="Ou use uma ISO que você já possui." Style="{StaticResource Secondary}"/>
                            </Grid>
                            </Grid>
                            <Expander Header="Outros downloads oficiais" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Escolha um idioma na página de download da Microsoft e cole aqui o link da ISO. Os links geralmente expiram após 24 horas."
                                               Style="{StaticResource Secondary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <HyperlinkButton Content="Downloads da Microsoft para x64 ↗" NavigateUri="https://www.microsoft.com/software-download/windows11"/>
                                        <HyperlinkButton Content="Downloads da Microsoft para ARM64 ↗" NavigateUri="https://www.microsoft.com/software-download/windows11arm64"/>
                                    </StackPanel>
                                    <HyperlinkButton Content="ISOs oficiais Insider / Canary ↗" NavigateUri="https://www.microsoft.com/software-download/windowsinsiderpreviewiso" Padding="0"/>
                                    <TextBox x:Name="DownloadUrlBox" Header="Link direto da Microsoft para a ISO" PlaceholderText="https://software.download.prss.microsoft.com/...iso?..."/>
                                    <TextBox x:Name="PublishedHashBox" Header="SHA-256 publicado (recomendado)" PlaceholderText="Copie da seção de verificação de download da Microsoft"/>
                                    <Button Content="Baixar ISO / retomar download" Click="OnDownload" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <StackPanel x:Name="CleanupPanel" Visibility="Collapsed" Spacing="18">
                            <TextBlock Text="Componentes" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="Escolha Tiny11, Tiny11 Core ou selecione suas remoções no modo Personalizado. Todas as alterações são registradas no log da criação." Style="{StaticResource Secondary}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <ComboBox x:Name="ModeChoice" Visibility="Collapsed" SelectionChanged="OnModeChanged" SelectedIndex="0">
                                        <ComboBoxItem Content="Tiny11"/>
                                        <ComboBoxItem Content="Tiny11 Core"/>
                                        <ComboBoxItem Content="Personalizado"/>
                                    </ComboBox>
                                    <Grid x:Name="RemovalModeCards" ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                        <Button x:Name="Tiny11Selection" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11" AutomationProperties.Name="Usar Tiny11">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Tiny11" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Remoções originais. Mantém suporte a atualizações." Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CoreSelection" Grid.Column="1" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Tiny11Core" AutomationProperties.Name="Usar Tiny11 Core">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Tiny11 Core" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Apenas o essencial. Para máquinas virtuais de teste." Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                        <Button x:Name="CustomSelection" Grid.Column="2" Style="{StaticResource ModeCard}" MinHeight="140" Click="OnRemovalModeClick" Tag="Custom" AutomationProperties.Name="Usar Personalizado">
                                            <StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="48" HorizontalAlignment="Left"/><TextBlock Text="Personalizado" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Escolha o que remover." Style="{StaticResource Secondary}"/></StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="ModeDescription" Style="{StaticResource Secondary}"/>
                                    <InfoBar x:Name="CoreWarning" IsOpen="False" IsClosable="False" Severity="Warning" Title="Core removes update and recovery support."
                                             Message="Core deletes component files and WinRE, and disables Windows Update and Defender. You cannot add updates, languages or features afterward. Test the image in a VM."/>
                                    <TextBlock x:Name="CoreConsentStatus" Visibility="Collapsed" Text="Será necessário aceitar as limitações do Core antes de continuar." Style="{StaticResource Secondary}"/>
                                    <TextBlock x:Name="SelectionCount" Style="{StaticResource Secondary}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="CustomChoices" Visibility="Collapsed" Spacing="18">
                            <ToggleSwitch x:Name="CustomCoreCheck" Header="Aplicar remoções do Core" OffContent="Manter atualizações, recuperação e Defender" OnContent="Remover atualizações, recuperação e Defender" Toggled="OnCustomCoreChanged"/>
                            <TextBlock Text="Os grupos marcados serão removidos ou desativados. Os demais serão mantidos. Para itens individuais, use a lista de componentes abaixo."
                                       Style="{StaticResource Secondary}"/>
                            <ComboBox x:Name="OptionFilter" Header="Mostrar opções" SelectedIndex="0" SelectionChanged="OnOptionFilterChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Todos"/><ComboBoxItem Content="Aplicativos pré-instalados"/><ComboBoxItem Content="Recursos opcionais"/>
                                <ComboBoxItem Content="Configurações do Windows"/><ComboBoxItem Content="Avançado / criador original"/>
                            </ComboBox>
                            <ItemsControl x:Name="OptionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,0,8">
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                      AutomationProperties.Name="{Binding Title}" AutomationProperties.FullDescription="{Binding Description}">
                                                <StackPanel Spacing="5" Margin="6,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="12"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Remoções avançadas" Style="{StaticResource Section}"/>
                                    <TextBlock Text="Lista aplicativos, pacotes, recursos, serviços e arquivos de componentes da imagem, incluindo itens protegidos. Remover um serviço exclui sua entrada no Registro, mas mantém os executáveis compartilhados. Pacotes protegidos podem impedir a remoção."
                                               Style="{StaticResource Secondary}"/>
                                    <Button Content="Listar todos os componentes…" Click="OnOpenExpert" HorizontalAlignment="Left"/>
                                    <StackPanel x:Name="ExpertPanel" Visibility="Collapsed" Spacing="12">
                                        <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Unsupported removals"
                                                 Message="Removing protected or boot-critical items can create an unbootable or insecure image. Direct payload removal bypasses servicing. No dependency solver or boot guarantee is provided."/>
                                        <CheckBox x:Name="ExpertConsent" Content="Aceito o risco de criar uma imagem personalizada que não inicialize, não aceite manutenção ou seja insegura." Checked="OnChoicesChanged" Unchecked="OnChoicesChanged"/>
                                        <TextBox x:Name="InventorySearch" PlaceholderText="Pesquisar componentes" TextChanged="OnInventoryFilterChanged"
                                                 AutomationProperties.Name="Pesquisar componentes"/>
                                        <ComboBox x:Name="InventoryFilter" SelectedIndex="0" SelectionChanged="OnInventoryFilterSelection" HorizontalAlignment="Stretch"
                                                  AutomationProperties.Name="Tipo de componente">
                                            <ComboBoxItem Tag="All" Content="Todos"/><ComboBoxItem Tag="ProvisionedApp" Content="Aplicativo provisionado"/><ComboBoxItem Tag="SystemApp" Content="Aplicativo do sistema"/>
                                            <ComboBoxItem Tag="Feature" Content="Recurso"/><ComboBoxItem Tag="Capability" Content="Funcionalidade"/><ComboBoxItem Tag="Package" Content="Pacote"/>
                                            <ComboBoxItem Tag="Service" Content="Serviço"/><ComboBoxItem Tag="ComponentPayload" Content="Arquivos de componentes"/>
                                        </ComboBox>
                                        <TextBlock x:Name="ExpertCount" Style="{StaticResource Secondary}"/>
                                        <TextBlock Text="As remoções individuais são adicionadas aos grupos selecionados. Para manter um componente, desmarque tanto o grupo quanto sua entrada individual."
                                                   Style="{StaticResource Secondary}" FontSize="12"/>
                                        <ListView x:Name="InventoryList" Height="420" SelectionMode="None" AutomationProperties.Name="Componentes da imagem">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnSpacing="12" Padding="0,8">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                                                  AutomationProperties.Name="{Binding Title}" AutomationProperties.FullDescription="{Binding Detail}">
                                                            <StackPanel Spacing="4" Margin="6,0,0,0">
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Secondary}" FontSize="11"/>
                                                                <TextBlock Text="{Binding Risk}" Foreground="{ThemeResource SystemFillColorCautionBrush}" FontSize="11"/>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                                                                  Visibility="{Binding HasModes, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Center"
                                                                  AutomationProperties.Name="{Binding ModeLabel}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <Button Content="Limpar seleções personalizadas" Click="OnClearExpert" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="Configurações de criação" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="Escolha onde criar a imagem e como compactá-la."
                                       Style="{StaticResource Secondary}"/>
                            <Border Style="{StaticResource Card}">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="16"><FontIcon Glyph="&#xE8B7;" FontSize="32"/><TextBlock Text="Arquivos e área de trabalho" FontSize="22" FontWeight="SemiBold"/></StackPanel>
                                    <TextBox x:Name="WorkspaceBox" Header="Área de trabalho (NTFS, geralmente 40 a 70 GiB livres)"/>
                                    <Button Content="Escolher área de trabalho" Click="OnChooseWorkspace" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="OutputBox" Header="Novo arquivo ISO de saída"/>
                                    <Button Content="Escolher saída" Click="OnChooseOutput" HorizontalAlignment="Left"/>
                                    <ComboBox x:Name="CompressionChoice" Header="Compactação da imagem de instalação" SelectedIndex="0" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="ESD de recuperação (menor, compactação mais lenta)"/>
                                        <ComboBoxItem Content="WIM máximo (facilita a manutenção posterior)"/>
                                        <ComboBoxItem Content="WIM rápido (criação mais rápida, ISO maior)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE945;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Modo Turbo" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Agrupa remoções de recursos e funcionalidades e reduz o processamento dos logs. Core e WIM rápido usam uma imagem de trabalho mais rápida. Consome mais CPU e espaço temporário; a compactação final segue a opção selecionada." Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="TurboCheck" Grid.Column="2" OffContent="Desativado" OnContent="Ativado" AutomationProperties.Name="Modo Turbo"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE74D;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Remover dados redundantes da imagem" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Remove caches de atualizações baixadas, logs antigos de manutenção, arquivos temporários e relatórios de falhas. Preserva dados de manutenção pendente, drivers e instaladores." Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RedundantDataCheck" Grid.Column="2" OffContent="Manter" OnContent="Remover" AutomationProperties.Name="Remover dados redundantes da imagem"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="Omitir arquivos de instalação do .NET 3.5" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Text="Exclui sources\sxs da ISO. Você ainda pode incluir o .NET 3.5 agora; ativá-lo depois exige mídia compatível ou o Windows Update. O Core não permite adicioná-lo depois." Style="{StaticResource Secondary}"/>
                                    </StackPanel>
                                    <ToggleSwitch x:Name="OmitSetupCheck" Grid.Column="2" OffContent="Manter" OnContent="Omitir" AutomationProperties.Name="Omitir arquivos de instalação do .NET 3.5"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B9;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Instalação compacta" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Instala o Windows com arquivos de sistema compactados para reduzir o uso de disco." Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="CompactCheck" Grid.Column="2" IsOn="True" OffContent="Desativado" OnContent="Ativado" AutomationProperties.Name="Instalação compacta"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE943;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text=".NET Framework 3.5" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Inclui suporte a aplicativos antigos. Os arquivos necessários devem estar presentes na ISO." Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="NetFxCheck" Grid.Column="2" OffContent="Desativado" OnContent="Ativado" AutomationProperties.Name=".NET Framework 3.5"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE77B;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Configuração de conta local" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Prioriza o uso de uma conta local na instalação. Algumas versões recentes ainda podem solicitar uma conta Microsoft." Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="LocalAccountCheck" Grid.Column="2" OffContent="Desativado" OnContent="Ativado" AutomationProperties.Name="Configuração de conta local"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Manter arquivos de trabalho" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Mantém a mídia de instalação modificada após salvar a ISO. Usa mais espaço em disco." Style="{StaticResource Secondary}"/></StackPanel>
                                    <ToggleSwitch x:Name="KeepFilesCheck" Grid.Column="2" OffContent="Desativado" OnContent="Ativado" AutomationProperties.Name="Manter arquivos de trabalho"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ToolStatus" Text="As ferramentas de imagem e ISO são preparadas automaticamente." Style="{StaticResource Secondary}"/>
                        </StackPanel>
                        <StackPanel x:Name="ReviewPanel" Visibility="Collapsed" Spacing="20">
                            <TextBlock Text="Revisar" Style="{StaticResource PageHeading}"/>
                            <TextBlock Text="Confira a imagem, as remoções e a saída antes de iniciar." Style="{StaticResource Secondary}"/>
                            <Grid x:Name="ReviewCards" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                                <Border x:Name="ReviewImageCard" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE7F4;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Imagem do Windows" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewImage" Style="{StaticResource Secondary}"/></StackPanel></Border>
                                <Border x:Name="ReviewModeCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock x:Name="ReviewMode" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewRemovals" Style="{StaticResource Secondary}"/></StackPanel></Border>
                                <Border x:Name="ReviewPathsCard" Grid.Row="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Saída e área de trabalho" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewPaths" Style="{StaticResource Secondary}" IsTextSelectionEnabled="True"/></StackPanel></Border>
                                <Border x:Name="ReviewOptionsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="12"><FontIcon Glyph="&#xE8B9;" FontSize="40" HorizontalAlignment="Left" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="Opções de instalação" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ReviewOptions" Style="{StaticResource Secondary}"/></StackPanel></Border>
                            </Grid>
                            <Border Style="{StaticResource Card}">
                                <Expander Header="Remoções selecionadas e configuração completa" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <TextBox x:Name="ReviewText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="13"/>
                                </Expander>
                            </Border>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Build-dependent settings"
                                     Message="Some policies apply only to particular editions or builds. Feature updates can reinstall apps. Local-account and hardware bypasses are best effort. Test the resulting ISO before relying on it."/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="Salvar configuração" Click="OnSaveRecipe"/>
                                <Button Content="Carregar configuração" Click="OnLoadRecipe"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="BuildPanel" Visibility="Collapsed" Spacing="32">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="BuildHeading" Text="Criar" Style="{StaticResource PageHeading}"/>
                                <TextBlock x:Name="BuildDescription" Text="A edição selecionada será copiada, modificada, compactada e salva como uma ISO inicializável."
                                           Style="{StaticResource Secondary}" FontSize="16"/>
                            </StackPanel>
                            <Border Style="{StaticResource Card}" Padding="32">
                                <StackPanel Spacing="32">
                                    <Grid ColumnSpacing="24">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Grid Width="64" Height="64" VerticalAlignment="Center">
                                            <ProgressRing x:Name="BuildActivity" IsActive="False" Width="64" Height="64" AutomationProperties.Name="Atividade da criação"/>
                                            <FontIcon x:Name="BuildGlyph" Glyph="&#xE7C5;" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="CurrentStage" Text="Aguardando início" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="CurrentMessage" Style="{StaticResource Secondary}" Text="Nenhuma alteração foi feita."/>
                                        </StackPanel>
                                        <TextBlock x:Name="BuildPercent" Grid.Column="2" Text="0%" FontSize="48" FontWeight="Light" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="16">
                                            <TextBlock Text="Progresso geral" Style="{StaticResource FieldLabel}"/>
                                            <TextBlock x:Name="OverallStep" HorizontalAlignment="Right" Style="{StaticResource Hint}"/>
                                        </Grid>
                                        <ProgressBar x:Name="OverallBar" Minimum="0" Maximum="100" MinHeight="10" AutomationProperties.Name="Progresso geral">
                                            <ProgressBar.Resources><x:Double x:Key="ProgressBarTrackHeight">10</x:Double></ProgressBar.Resources>
                                        </ProgressBar>
                                    </StackPanel>
                                    <StackPanel Spacing="12">
                                        <Grid ColumnSpacing="16">
                                            <TextBlock Text="Operação atual" Style="{StaticResource Secondary}" FontSize="14"/>
                                            <TextBlock x:Name="CurrentPercent" HorizontalAlignment="Right" Style="{StaticResource Hint}"/>
                                        </Grid>
                                        <ProgressBar x:Name="BuildBar" Minimum="0" Maximum="100" AutomationProperties.Name="Progresso da operação atual"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CancelHint" Visibility="Collapsed" Style="{StaticResource Hint}"
                                               Text="Para interromper, use Cancelar com segurança no canto superior direito. A criação para no próximo ponto seguro. A origem não é alterada; os arquivos de trabalho, o progresso salvo e os logs são mantidos."/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="ResultPanel" Style="{StaticResource Card}" Padding="32" Visibility="Collapsed">
                                <StackPanel Spacing="24">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE73E;" FontSize="32" VerticalAlignment="Top" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <TextBlock Text="ISO criada" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="ResultMetrics" Style="{StaticResource Secondary}"/>
                                        </StackPanel>
                                    </Grid>
                                    <InfoBar x:Name="ResultWarnings" IsOpen="False" IsClosable="False" Severity="Warning" Title="Finished with warnings"/>
                                    <StackPanel Spacing="16">
                                        <TextBox x:Name="ResultPath" Header="ISO de saída" IsReadOnly="True"/>
                                        <TextBox x:Name="ResultHash" Header="SHA-256" IsReadOnly="True" FontFamily="Consolas"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="Abrir pasta de saída" Click="OnOpenOutputFolder"/>
                                        <Button Content="Abrir logs e relatório" Click="OnOpenLogs"/>
                                    </StackPanel>
                                    <TextBlock Text="Teste a ISO em uma máquina virtual antes de instalar o Windows." Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Histórico de operações" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="HistoryCount" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Secondary}" Text="0 de 7 etapas concluídas"/>
                                </Grid>
                                <TextBlock Text="Expanda uma etapa para ver as operações e os detalhes de erros." Style="{StaticResource Hint}"/>
                                <ItemsControl x:Name="BuildStages">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                  IsExpanded="{Binding Expanded, Mode=TwoWay}" AutomationProperties.Name="{Binding AutomationName}">
                                            <Expander.Header>
                                                <Grid ColumnSpacing="16" HorizontalAlignment="Stretch" MinHeight="56">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="13" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="260"/>
                                                </Grid>
                                            </Expander.Header>
                                            <ListView ItemsSource="{Binding Operations}" SelectionMode="None" MaxHeight="360">
                                                <ListView.ItemTemplate><DataTemplate>
                                                    <Grid ColumnSpacing="16" Padding="0,10" AutomationProperties.Name="{Binding AutomationName}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,2,0,0">
                                                            <FontIcon Glyph="{Binding Glyph}" FontSize="16" Opacity="0.65"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Pending|Skipped'}"/>
                                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Completed'}"/>
                                                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Running'}"/>
                                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Failed'}"/>
                                                            <FontIcon Glyph="&#xE711;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                                      Visibility="{Binding State, Converter={StaticResource StateVisibility}, ConverterParameter='Cancelled'}"/>
                                                        </Grid>
                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" Style="{StaticResource Secondary}" FontSize="12" IsTextSelectionEnabled="True"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                    </Grid>
                                                </DataTemplate></ListView.ItemTemplate>
                                            </ListView>
                                        </Expander>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Expander x:Name="BuildDetails" Header="Detalhes da criação" IsExpanded="False" Expanding="OnDetailsExpanding"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="BuildLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         Height="300" FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="OnLogSelectionChanged" AutomationProperties.Name="Log da criação"/>
                            </Expander>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="StepNumber" Grid.Row="2" Text="1" FontSize="112" FontWeight="Light"
                           Opacity="0.10" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,28,0"
                           IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw"/>
                <Grid x:Name="ActionArea" Grid.Row="3" Padding="32,8,32,24" ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="ResumeRunButton" Visibility="Collapsed" Content="Retomar criação" Click="OnResumeStopped"
                                AutomationProperties.HelpText="Continua esta criação a partir do progresso salvo."/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="NextButton" MinWidth="140" Click="OnNext" Background="Transparent" BorderThickness="0" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock x:Name="ActionLabel" Text="Iniciar" FontSize="32" FontWeight="Light" Opacity="{ThemeResource ActionLabelOpacity}"/>
                            <FontIcon x:Name="ActionArrow" Glyph="&#xE72A;" FontSize="24" Opacity="{ThemeResource ActionArrowOpacity}"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Grid>
                <!-- Drawn over the pane so showing it never moves the page. -->
                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" VerticalAlignment="Top" Margin="16,0,0,0" IsHitTestVisible="False"
                             Visibility="Collapsed" AutomationProperties.Name="Processando"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
